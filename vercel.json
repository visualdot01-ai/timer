{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,
 "installCommand":"",
 "buildCommand":"",
 "outputDirectory":"public",
 "rewrites":[
  {"source":"/api/timers/:id","destination":"/api/timer?id=:id"},
  {"source":"/admin/:id","destination":"/index.html"},
  {"source":"/view/:id","destination":"/index.html"}
 ],
 "headers":[
  {"source":"/(.*)","headers":[{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"SAMEORIGIN"}]},
  {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
  {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]}
 ]
}
